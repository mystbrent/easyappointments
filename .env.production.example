# Copy to .env beside docker-compose.production.yml and fill in. NEVER commit .env.
#
# Generate each secret with:  openssl rand -base64 24 | tr -d '/+=' | head -c 32
#
# These are the values the committed manifests reference by name — a manifest
# holds only *_env pointers, never a credential.

# ── Caddy / TLS ──────────────────────────────────────────────────────────────
# Let's Encrypt sends expiry warnings here. A real inbox you read.
ACME_EMAIL=you@knowwhats.best

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
ZEEKR_DB_PASSWORD=
LOSTLOCKS_DB_PASSWORD=

# ── Storefront origins (CORS) ────────────────────────────────────────────────
# The exact origin the browser sends. Scheme + host, no trailing slash, no path.
# Get this wrong and every booking call fails with a CORS error that looks
# like the API is down.
ZEEKR_CORS_ORIGINS=https://pt-selfsell-zeekr-gold-coast-app.indiebuildinganton.workers.dev
LOSTLOCKS_CORS_ORIGINS=https://lostlocks-pwa.indiebuildinganton.workers.dev

# ── Seeder secrets, Zeekr ────────────────────────────────────────────────────
# EA admin login for zeekr.bookings.knowwhats.best
ZEEKR_ADMIN_PASSWORD=
ZEEKR_PROVIDER_PASSWORD=
# Becomes EA's api_token. The Worker sends this as `Authorization: Bearer <...>`.
ZEEKR_API_KEY=
# Shared secret EA sends as x-ea-token on webhook calls; the Worker verifies it.
ZEEKR_WEBHOOK_SECRET=

# ── Seeder secrets, Lostlocks ────────────────────────────────────────────────
LOSTLOCKS_ADMIN_PASSWORD=
LOSTLOCKS_PROVIDER_PASSWORD=
LOSTLOCKS_API_KEY=
LOSTLOCKS_WEBHOOK_SECRET=

# ── Backups (scripts/backup-databases.sh) ────────────────────────────────────
# MySQL is published on loopback only, so the host-side backup script reaches
# it at 127.0.0.1. Requires `apt install mysql-client` on the host.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ADMIN_USER=root
# Same value as MYSQL_ROOT_PASSWORD above.
MYSQL_ADMIN_PASS=
BACKUP_DIR=/opt/easyappointments/backups
KEEP_HOURLY=24
KEEP_WEEKLY=8
